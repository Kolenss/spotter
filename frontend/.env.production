# The API is a separate Render service, so the browser crosses an origin to
# reach it and CORS_ALLOWED_ORIGINS on the backend has to name this site.
# Baked into the bundle at build time -- changing it needs a rebuild, not just
# a restart. The dev default in api.ts stays http://localhost:8000/api.
VITE_API_BASE_URL=https://spotter-82f0.onrender.com/api
