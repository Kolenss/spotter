# Copy to backend/.env and fill in. That file is gitignored; this one is not,
# so never put a real secret here.
#
# Everything below has a working development default in config/settings.py --
# you only need to set these when connecting to a real database or deploying.


# -- Database ----------------------------------------------------------------
#
# Omit entirely to use the local SQLite file. Set it to point at Postgres.
#
# Supabase: dashboard -> Connect -> "Session pooler". Take that string, NOT:
#   - the transaction pooler (port 6543) -- it cannot hold the prepared
#     statements `manage.py migrate` needs, and migrations will fail oddly
#   - the direct connection -- IPv6 only, unreachable from most hosts
#
# The password is in the string, which is why this belongs in .env.
#
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase terminates TLS at the pooler and requires it. Leave this off for a
# local Postgres without certificates.
# DATABASE_SSL_REQUIRE=true


# -- Django ------------------------------------------------------------------
#
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Defaults to true. Must be false in production -- it leaks stack traces.
# DJANGO_DEBUG=false

# Hosts Django will answer for. Required once DEBUG is off.
# DJANGO_ALLOWED_HOSTS=spotter-api.onrender.com


# -- Truck-legal routing -------------------------------------------------------
#
# Without this, routes come from OSRM's *car* profile: right roads, wrong
# vehicle. It does not know about low bridges, weight-limited bridges or roads
# that ban lorries, and the app says so on each trip rather than pretending
# otherwise.
#
# With it, routes come from OpenRouteService's `driving-hgv` profile, planned
# for a standard 53ft dry van (13'6", 80,000 lb, 5 axles -- see routing/trucks.py).
#
# Free key from https://account.heigit.org -- name, email, captcha. No payment
# details are asked for. The free Standard plan allows 2,000 directions calls a
# day at 40 a minute; Spotter uses two per trip, so about 1,000 trips a day.
#
# Caveat worth knowing: ORS routes on OpenStreetMap, so it can only avoid a low
# bridge somebody has tagged. US coverage is patchy. Much better than a car
# profile, not a substitute for commercial truck-attribute data.
#
# ORS_API_KEY=


# -- Cross-origin ------------------------------------------------------------
#
# Not needed on Vercel. vercel.json rewrites /api/* to this service, so the
# browser sees one origin and never sends a cross-origin request at all.
#
# Only set these when the API is served from a different host than the React
# app -- a separate Render service, say. Exact origin, no trailing slash.
# CORS_ALLOWED_ORIGINS=https://spotter.vercel.app
# CSRF_TRUSTED_ORIGINS=https://spotter.vercel.app
