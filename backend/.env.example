# Copy to backend/.env and fill in. That file is gitignored; this one is not,
# so never put a real secret here.
#
# Everything below has a working development default in config/settings.py --
# you only need to set these when connecting to a real database or deploying.


# -- Database ----------------------------------------------------------------
#
# Omit entirely to use the local SQLite file. Set it to point at Postgres.
#
# Supabase: dashboard -> Connect -> "Session pooler". Take that string, NOT:
#   - the transaction pooler (port 6543) -- it cannot hold the prepared
#     statements `manage.py migrate` needs, and migrations will fail oddly
#   - the direct connection -- IPv6 only, unreachable from most hosts
#
# The password is in the string, which is why this belongs in .env.
#
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase terminates TLS at the pooler and requires it. Leave this off for a
# local Postgres without certificates.
# DATABASE_SSL_REQUIRE=true


# -- Django ------------------------------------------------------------------
#
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Defaults to true. Must be false in production -- it leaks stack traces.
# DJANGO_DEBUG=false

# Hosts Django will answer for. Required once DEBUG is off.
# DJANGO_ALLOWED_HOSTS=spotter-api.onrender.com


# -- Cross-origin ------------------------------------------------------------
#
# The React app is served from a different origin than this API, so its exact
# origin has to be named. No trailing slash.
# CORS_ALLOWED_ORIGINS=https://spotter.vercel.app
# CSRF_TRUSTED_ORIGINS=https://spotter.vercel.app
